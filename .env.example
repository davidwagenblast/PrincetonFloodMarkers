# Copy to .env in the repo root and fill in. Read by both the server (npm start / npm run dev)
# and the page build (npm run build). .env is gitignored, so real values never reach GitHub.
# Rebuild (npm run build) after changing BASE_PATH or any VITE_ setting.

# ---- Where the site lives ----
# BASE_PATH=/PFlood/            # URL path when not at the domain root, e.g. https://example.edu/PFlood/
# API_PORT=3001
# HOST=127.0.0.1                # listen only on this machine, so visitors must come through the front web server

# ---- Access ----
# IP_ALLOWLIST=on               # restrict the whole site to the ranges in ip-allowlist.txt; off/unset = open
# TRUST_PROXY=1                 # set when behind a reverse proxy (Apache, nginx) so the real visitor IP is used
# EMBED_ALLOWED_ORIGINS=https://example.org https://www.example.org   # sites allowed to embed /embed in an iframe; unset = any site

# ---- Services ----
# NOMINATIM_CONTACT=you@example.org   # contact email sent to OpenStreetMap's place search (required by their policy)
# SUBMISSIONS_PER_HOUR=20       # new markers allowed per IP address per hour

# ---- Storage ---- (defaults: server/data/floodlite.db and server/uploads; use absolute paths to move them)
# DB_PATH=/srv/pflood-data/floodlite.db
# UPLOADS_DIR=/srv/pflood-data/uploads

# ---- Page (build-time) ----
# VITE_REGION_LABEL=Princeton         # small label above the logo; empty to hide
# VITE_DEFAULT_VIEW=40.3350,-74.6800,12   # lat,lng,zoom the map opens at
