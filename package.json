{
  "name": "pfloodlite",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal community map of historical flood markers and geodetic markers.",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:init": "npm run db:init -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.63.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
